# Add these in Vercel's project settings (or copy to .env.local for a local build).
# Never commit real values.

# Required for "What it is", the investors, and screenshot breakdowns.
OPENROUTER_API_KEY=
# Optional: use exactly this one model for every AI call.
OPENROUTER_MODEL=

# Optional, free, no sign-up: a contact email the SEC asks for when the site
# reads company profit, debt, and cash flow from its public data. Kept here so
# it never appears in the public code. Without it, the investors judge stocks
# by price history only.
SEC_CONTACT_EMAIL=
